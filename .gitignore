# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent tooling / editor config
.claude/
.gstack/

# Hero source clips — the originals behind public/video/home-scroll*.mp4.
# 60 MB of render that nothing serves; kept locally, out of the history.
/assets/video-source/*.mp4

# Downloaded reference demos — the scroll/gooey experiments the site's own
# effects were built from. Read locally, never imported; they also carry every
# lint error in the tree.
/files/
/files\ 2/
/files\ 3/
/files3.1/
/files4/
/files5/
/Scroll-Transition-main/
/gooey-hover-codrops-master/
/Legacy 1.0/
/Legacy 1.1/
/Legacy 1.2/

# The three Legacy demos above are the same kind of thing and are named in
# comments as the source of two effects — the Capsule preloader behind the
# hero in `legacy-hero.tsx`, and the stack behind `LegacyChapters`. They
# carry 47 MB of media between them, including a 30 MB smoke clip, none of
# which is imported or served.

# The brochures as the client supplied them, at the repo root. The copies
# that are served — and the page images rendered off them — are committed
# under `public/brochures/` and `assets/brochures/`; these are the same
# 21 MB again, under names nothing references.
/E-Brochure.pdf
/E-BROCHURE*.pdf
