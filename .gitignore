# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent tooling / editor config
.claude/
.gstack/

# Hero source clips — the originals behind public/video/home-scroll*.mp4.
# 60 MB of render that nothing serves; kept locally, out of the history.
/assets/video-source/*.mp4

# Downloaded reference demos — the scroll/gooey experiments the site's own
# effects were built from. Read locally, never imported; they also carry every
# lint error in the tree.
/files/
/files\ 2/
/files\ 3/
/files3.1/
/files4/
/files5/
/Scroll-Transition-main/
/gooey-hover-codrops-master/
